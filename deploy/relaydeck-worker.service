[Unit]
Description=RelayDeck database coordinator
After=relaydeck-broker.service relaydeck-web.service
Requires=relaydeck-broker.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=exec
User=relaydeck
Group=relaydeck
EnvironmentFile=/etc/relaydeck/relaydeck.env
ExecStart=/usr/local/libexec/relaydeck worker /etc/relaydeck/broker.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/relaydeck/data
MemoryMax=128M
TasksMax=24

[Install]
WantedBy=multi-user.target

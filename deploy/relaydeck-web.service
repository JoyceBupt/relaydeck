[Unit]
Description=RelayDeck web API
After=network.target relaydeck-broker.service
Wants=relaydeck-broker.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=exec
User=relaydeck
Group=relaydeck
EnvironmentFile=/etc/relaydeck/relaydeck.env
ExecStartPre=+/usr/bin/python3 -B /usr/local/libexec/relaydeck-manage.py prepare-frontend
ExecStart=/usr/local/libexec/relaydeck serve
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/relaydeck/data /var/lib/relaydeck/secrets /var/lib/relaydeck/backups

MemoryHigh=infinity
MemoryMax=infinity
MemorySwapMax=infinity
CPUQuota=
TasksMax=infinity
LimitNOFILE=infinity

[Install]
WantedBy=multi-user.target
